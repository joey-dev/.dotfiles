{
  description = "NixOS dotfiles configuration";

  inputs = {
    # Home Manager and user packages
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";
    # NixOS itself stays on the stable release
    nixpkgs-stable.url = "github:nixos/nixpkgs/nixos-26.05";
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      nixpkgs-stable,
      home-manager,
      ...
    }:
    let
      inherit (nixpkgs) lib;

      system = "x86_64-linux";
      username = "joey";
      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfree = true;
      };

      # Every laptop, with the roles it uses
      hosts = {
        work.roles = import ./hosts/roles.nix;
        personal.roles = import ./hosts/roles.nix;
      };

      enableRoles = roles: {
        roles = lib.genAttrs roles (_: {
          enable = true;
        });
      };

      mkHome =
        host:
        home-manager.lib.homeManagerConfiguration {
          inherit pkgs;
          modules = [
            ./roles
            ./hosts/home.nix
            (enableRoles host.roles)
            {
              home.username = username;
              home.homeDirectory = "/home/${username}";
            }
          ];
        };

      mkSystem =
        hostname: host:
        nixpkgs-stable.lib.nixosSystem {
          specialArgs = { inherit username; };
          modules = [
            ./roles/system.nix
            ./hosts/common.nix
            ./hosts/${hostname}/configuration.nix
            (enableRoles host.roles)
            { networking.hostName = hostname; }
          ];
        };

      # A host only gets a NixOS config once its files are in hosts/<name>/
      nixosHosts = lib.filterAttrs (
        hostname: _: builtins.pathExists ./hosts/${hostname}/configuration.nix
      ) hosts;

      # Generated by nixos-generate-config; keep them as the generator writes them
      deadnixExcludes = [ "hosts/*/hardware-configuration.nix" ];

      # Shell scripts still waiting to be replaced (see PLAN.md, phase 3)
      shellcheckExcludes = [
        "roles/i3/configuration/scripts/Startup/main.sh"
        "roles/i3/configuration/scripts/Windows/window"
      ];

      mkLintCheck =
        name: packages: script:
        pkgs.runCommand "lint-${name}" { nativeBuildInputs = packages; } ''
          cd ${self}
          ${script}
          touch $out
        '';
    in
    {
      # home-manager switch --flake .   (picks joey@<hostname>)
      homeConfigurations = lib.mapAttrs' (
        hostname: host: lib.nameValuePair "${username}@${hostname}" (mkHome host)
      ) hosts;

      # sudo nixos-rebuild switch --flake .   (picks <hostname>)
      nixosConfigurations = lib.mapAttrs mkSystem nixosHosts;

      # The Home Manager version pinned in flake.lock, used by bootstrap.sh
      packages.${system}.home-manager = home-manager.packages.${system}.default;

      templates.php-symfony = {
        path = ./templates/php-symfony;
        description = "PHP/Symfony project with its own dev shell";
      };

      # `nix fmt` formats every .nix file in the repo
      formatter.${system} = pkgs.nixfmt-tree;

      # Checks that run when you do `nix flake check`
      checks.${system} =
        # Build the Home Manager config of every host
        lib.mapAttrs' (
          name: config: lib.nameValuePair "home-${name}" config.activationPackage
        ) self.homeConfigurations
        # Evaluate (not build) every NixOS config; building pulls in kernels and firmware
        // lib.mapAttrs' (
          name: config:
          lib.nameValuePair "nixos-${name}" (
            pkgs.writeText "nixos-${name}-drv" (
              builtins.unsafeDiscardStringContext config.config.system.build.toplevel.drvPath
            )
          )
        ) self.nixosConfigurations
        // {
          nixfmt = mkLintCheck "nixfmt" [ pkgs.nixfmt ] ''
            find . -name '*.nix' -print0 | xargs -0 nixfmt --check
          '';

          statix = mkLintCheck "statix" [ pkgs.statix ] ''
            statix check .
          '';

          deadnix = mkLintCheck "deadnix" [ pkgs.deadnix ] ''
            deadnix --fail --exclude ${toString deadnixExcludes} -- .
          '';

          shellcheck = mkLintCheck "shellcheck" [ pkgs.shellcheck ] ''
            scripts=()
            while read -r file; do
              case " ${toString shellcheckExcludes} " in
                *" $file "*) continue ;;
              esac
              if head -n1 "$file" | grep -qE '^#!.*\b(ba)?sh\b'; then
                scripts+=("$file")
              fi
            done < <(echo bootstrap.sh; find roles -type f -path '*/configuration/*' | sort)
            printf 'shellcheck %s\n' "''${scripts[@]}"
            shellcheck "''${scripts[@]}"
          '';
        };
    };
}

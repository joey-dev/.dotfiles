# Copy this file to local.nix and fill in your personal details.
# local.nix is gitignored so it will never appear in your git status.
#
# Usage:
#   cp local.nix.example local.nix
#   # Edit local.nix with your details, then:
#   make switch
{
  # Your system username (must match your Linux user account)
  username = "yourname";

  # Your git identity (kept private, not committed to the repo)
  extraModules = [
    {
      programs.git = {
        userName = "Your Name";
        userEmail = "your@email.com";
      };
    }
  ];
}

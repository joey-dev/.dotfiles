{
  "$schema": "../config.schema.json",
  "commands": {
    "composer-install": {
      "description": "Install PHP dependencies inside the web container of the compose stack.",
      "run-in": "container",
      "container": "dyflexis-monorepo-legacy-web-debug-1",
      "user": "1000:1000",
      "needs-compose-stack": true,
      "command": "composer install"
    },
    "cs-check": {
      "description": "Code style check with bin/cs (pre-commit) on the files changed on this ticket. Runs in the sandbox on a throwaway git repo (needs-git). Skipped when no file changed.",
      "run-in": "sandbox",
      "needs-git": true,
      "command": "bin/cs {{files}}",
      "parameters": {
        "files": {
          "description": "Files to check, relative to the repository root. Default: all changed files.",
          "default": {
            "changed-files": {
              "include": [
                "*"
              ],
              "if-none": "skip"
            }
          }
        }
      }
    },
    "phpstan": {
      "description": "Static analysis of PHP code.",
      "run-in": "sandbox",
      "working-directory": "legacy",
      "command": "vendor/bin/phpstan analyze {{paths}} --memory-limit=-1 --no-progress -c {{config-file}}",
      "timeout": "15m",
      "parameters": {
        "paths": {
          "description": "Directories or files to analyse. Empty: the paths from the config file.",
          "example": "Core Common app src"
        },
        "config-file": {
          "description": "PHPStan config file.",
          "default": "phpstan.neon.dist",
          "pattern": "^phpstan[A-Za-z0-9_.-]*\\.neon(\\.dist)?$",
          "example": "phpstan-tests.neon.dist"
        }
      }
    },
    "phpstan:changed": {
      "description": "Static analysis of only the PHP files changed on this ticket (tests excluded). Skipped when no PHP file changed.",
      "run-in": "sandbox",
      "working-directory": "legacy",
      "command": "vendor/bin/phpstan analyze {{paths}} --memory-limit=-1 --no-progress -c {{config-file}}",
      "timeout": "15m",
      "parameters": {
        "paths": {
          "description": "Files to analyse. Default: the changed PHP files.",
          "default": {
            "changed-files": {
              "include": [
                "*.php"
              ],
              "exclude": [
                "*Test.php",
                "*/Tests/*",
                "tests/*"
              ],
              "if-none": "skip"
            }
          }
        },
        "config-file": {
          "description": "PHPStan config file.",
          "default": "phpstan.neon.dist",
          "pattern": "^phpstan[A-Za-z0-9_.-]*\\.neon(\\.dist)?$",
          "example": "phpstan-tests.neon.dist"
        }
      }
    },
    "phpunit": {
      "description": "PHP unit tests.",
      "run-in": "sandbox",
      "working-directory": "legacy",
      "command": "vendor/bin/phpunit {{filter}} --config=phpunit.xml.dist",
      "timeout": "20m",
      "parameters": {
        "filter": {
          "description": "Only run tests whose name matches.",
          "format": "--filter {{value}}",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_\\\\:.-]*$",
          "example": "InvoiceTest"
        }
      }
    },
    "tests:api": {
      "description": "Codeception API suite through test_runner.sh. A filter is required: the full suite takes too long.",
      "run-in": "host",
      "needs-compose-stack": true,
      "command": "./test_runner.sh api {{filter}}",
      "timeout": "20m",
      "parameters": {
        "filter": {
          "description": "Test file or test name.",
          "required": true,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./:-]*$",
          "example": "InvoiceCest.php"
        }
      }
    },
    "tests:integration": {
      "description": "Codeception integration suite through test_runner.sh. A filter is required: the full suite takes too long.",
      "run-in": "host",
      "needs-compose-stack": true,
      "command": "./test_runner.sh integration {{filter}}",
      "timeout": "20m",
      "parameters": {
        "filter": {
          "description": "Test file or directory.",
          "required": true,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./:-]*$",
          "example": "tests/integration/Invoice"
        }
      }
    }
  },
  "verify": [
    {
      "run": "phpstan",
      "parameters": {
        "paths": "Core Common app src"
      }
    },
    {
      "run": "phpstan",
      "parameters": {
        "paths": "Component"
      }
    },
    {
      "run": "phpstan",
      "parameters": {
        "config-file": "phpstan-tests.neon.dist"
      }
    },
    {
      "run": "phpunit"
    }
  ],
  "shared-dependencies": [
    {
      "dir": "legacy/vendor",
      "lockfile": "legacy/composer.lock"
    },
    {
      "dir": "legacy/app/node_modules",
      "lockfile": "legacy/app/pnpm-lock.yaml"
    },
    {
      "dir": "frontend/node_modules",
      "lockfile": "frontend/pnpm-lock.yaml"
    },
    {
      "dir": "tools/vendor",
      "lockfile": "tools/composer.lock"
    }
  ],
  "docker-compose": {
    "project-name": "dyflexis-monorepo",
    "profile": "dyflexis",
    "up-timeout": "15m",
    "host-copies": [
      {
        "path": "nginx-proxy/certs",
        "include": [
          "*.crt"
        ]
      }
    ],
    "create-dirs": [
      "legacy/cache"
    ],
    "services": [
      "legacy-web-debug",
      "lighttpd",
      "db",
      "redis"
    ]
  }
}

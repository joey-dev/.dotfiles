{
  "$schema": "config.schema.json",
  "kb-path": "~/notes/work-kb",
  "flake-path": "~/.dotfiles/templates/latest",
  "docker-host": "unix:///var/lib/cw-docker-sock/docker.sock",
  "worktree-base": "/srv/claude-workflow/worktrees",
  "max-plan-reviews": 2,
  "max-escalations": 3,
  "max-fix-rounds": 3,
  "headless-timeout": "60m",
  "commit-no-verify": true,
  "stages": {
    "intake": {
      "model": "sonnet",
      "thinking": "medium",
      "repo-access": "none",
      "allow-network": true,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Write",
        "mcp__Atlassian-Rovo-MCP__*"
      ]
    },
    "explore": {
      "model": "opus",
      "thinking": "high",
      "repo-access": "ro",
      "allow-network": true,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Glob",
        "Grep",
        "Write",
        "WebFetch"
      ]
    },
    "qa": {
      "model": "sonnet",
      "thinking": "medium",
      "repo-access": "ro",
      "allow-network": false,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Glob",
        "Grep",
        "Write"
      ]
    },
    "plan": {
      "model": "opus",
      "thinking": "high",
      "repo-access": "ro",
      "allow-network": true,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Glob",
        "Grep",
        "Write",
        "WebFetch"
      ]
    },
    "implement": {
      "model": "sonnet",
      "thinking": "high",
      "repo-access": "rw",
      "allow-network": false,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash"
      ]
    },
    "verify": {
      "model": "sonnet",
      "thinking": "low",
      "repo-access": "rw",
      "allow-network": false,
      "mcp-config": null,
      "allowed-tools": []
    },
    "review": {
      "model": "opus",
      "thinking": "high",
      "repo-access": "ro",
      "allow-network": false,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Glob",
        "Grep",
        "Write"
      ]
    },
    "retro": {
      "model": "sonnet",
      "thinking": "medium",
      "repo-access": "none",
      "allow-network": false,
      "mcp-config": null,
      "allowed-tools": [
        "Read",
        "Write"
      ]
    }
  }
}

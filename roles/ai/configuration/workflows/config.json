    "review": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write"]
    },
    "retro": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "ro",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Write"]
    }

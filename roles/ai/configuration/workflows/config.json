{
  "kb_path": "~/notes/work-kb",
  "flake_path": "~/.dotfiles/templates/latest",
  "verify_commands": [
    "cd legacy && files=$(sed -n 's#^legacy/##p' \"$CW_CHANGED_FILES\" | grep '\\.php$' || true); if [ -z \"$files\" ]; then echo 'no changed PHP files'; else vendor/bin/phpstan analyze --memory-limit=-1 --no-progress -c phpstan.neon.dist $files; fi"
  ],
  "shared_dependencies": [
    { "dir": "legacy/vendor", "lockfile": "legacy/composer.lock" },
    { "dir": "legacy/app/node_modules", "lockfile": "legacy/app/pnpm-lock.yaml" },
    { "dir": "frontend/node_modules", "lockfile": "frontend/pnpm-lock.yaml" },
    { "dir": "tools/vendor", "lockfile": "tools/composer.lock" }
  ],
  "docker": {
    "project_name": "dyflexis-monorepo",
    "profile": "dyflexis",
    "host_copies": ["nginx-proxy/certs"],
    "create_dirs": ["legacy/cache"]
  },
  "max_plan_reviews": 2,
  "max_escalations": 3,
  "max_fix_rounds": 3,
  "headless_timeout": 3600,
  "verify_timeout": 1800,
  "commit_no_verify": true,
  "stages": {
    "intake": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "none",
      "allow_network": true,
      "mcp_config": null,
      "allowed_tools": ["Read", "Write", "mcp__Atlassian-Rovo-MCP__*"]
    },
    "explore": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": true,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write", "WebFetch"]
    },
    "qa": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "ro",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write"]
    },
    "plan": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": true,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write", "WebFetch"]
    },
    "implement": {
      "model": "sonnet",
      "thinking": "high",
      "repo_access": "rw",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Edit", "Write", "Glob", "Grep", "Bash"]
    },
    "verify": {
      "model": "sonnet",
      "thinking": "low",
      "repo_access": "rw",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": []
    },
    "review": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write"]
    },
    "retro": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "none",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Write"]
    }
  }
}

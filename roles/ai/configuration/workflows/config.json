{
  "kb_path": "~/notes/work-kb",
  "flake_path": null,
  "verify_commands": [],
  "shared_dependencies": [
    { "dir": "vendor", "lockfile": "composer.lock" },
    { "dir": "node_modules", "lockfile": "package-lock.json" }
  ],
  "max_plan_reviews": 2,
  "max_escalations": 3,
  "max_fix_rounds": 3,
  "headless_timeout": 3600,
  "verify_timeout": 1800,
  "commit_no_verify": true,
  "stages": {
    "intake": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "none",
      "allow_network": true,
      "mcp_config": null,
      "allowed_tools": ["Read", "Write", "mcp__Atlassian-Rovo-MCP__*"]
    },
    "explore": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": true,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write", "WebFetch"]
    },
    "qa": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "ro",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write"]
    },
    "plan": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": true,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write", "WebFetch"]
    },
    "implement": {
      "model": "sonnet",
      "thinking": "high",
      "repo_access": "rw",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Edit", "Write", "Glob", "Grep", "Bash"]
    },
    "verify": {
      "model": "sonnet",
      "thinking": "low",
      "repo_access": "rw",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": []
    },
    "review": {
      "model": "opus",
      "thinking": "high",
      "repo_access": "ro",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Glob", "Grep", "Write"]
    },
    "retro": {
      "model": "sonnet",
      "thinking": "medium",
      "repo_access": "none",
      "allow_network": false,
      "mcp_config": null,
      "allowed_tools": ["Read", "Write"]
    }
  }
}

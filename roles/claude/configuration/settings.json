{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_UPDATES": "1"
  },
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(home-manager)",
      "Bash(home-manager *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Claude needs your input\"' | xargs -0 notify-send --app-name='Claude Code' --urgency=critical 'Claude Code'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send --app-name='Claude Code' 'Claude Code' 'Done'"
          }
        ]
      }
    ]
  },
  "editorMode": "vim"
}
